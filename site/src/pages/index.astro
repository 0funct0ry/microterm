---
// Marketing page (SPEC §16), implemented from MARKETING-MOCKUP.html.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/marketing.css';
import logo from '../assets/logo.svg';
import { VERSION } from '../version';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://0funct0ry.github.io/microterm';
const version = VERSION;
const title = 'microterm: a high-performance, cross-platform terminal with GPU acceleration';
const description =
  'GPU-rendered terminal with workspaces, quick select, vi-style copy mode and SSH sessions that survive a dropped connection. Configured in one TOML file.';
---
<!doctype html>
<html lang="en" data-version={version}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem('starlight-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class="mk">
<header class="nav">
  <div class="wrap">
    <a class="brand" href={`${base}/`}><img class="brand-mark" src={logo.src} width="24" height="24" alt="" />microterm</a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#features" class="hide-sm">Features</a>
      <a href="#osc" class="hide-sm">Integrations</a>
      <a href="#compare" class="hide-sm">Compare</a>
      <a href={`${base}/docs/installation/`}>Docs</a>
      <a href="https://github.com/0funct0ry/microterm">GitHub</a>
    </nav>
    <button class="icon-btn" id="pageTheme" aria-label="Toggle light and dark page theme" title="Toggle page theme">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<main>
<div class="wrap">
  <section class="hero" style="padding-top:72px">
    <h1>A high-performance, cross-platform terminal with GPU acceleration.</h1>
    <p class="lede">Featuring GPU-accelerated rendering, zero-config setup, automatic configuration reload on save, built-in workspaces, shell integration and more.</p>
    <div class="cta">
      <a class="btn primary" href="#install">Get started</a>
      <a class="btn" href={`${base}/docs/installation/`}>Read the docs</a>
    </div>
    <p class="meta-line">v{version} for macOS 12+ and Linux (Wayland or X11). MIT licensed.</p>

    <!-- interactive demo -->
    <div class="demo">
      <div class="term" id="term" tabindex="0" aria-label="Interactive microterm demo. Focus it and use the shortcuts listed below.">
        <div class="tb">
          <div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
          <button class="ws-chip" id="wsChip" title="Switch workspace"><span id="wsName">payments</span><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          <div class="tb-title" id="tbTitle">~/src/payments-api — zsh</div>
          <div class="domain"><span class="dot ok" id="domDot"></span><span id="domName">local</span></div>
        </div>
        <div class="tabs" role="tablist" id="tabs"></div>
        <div class="viewport" id="vp">
          <div class="grid" id="grid" aria-live="off"></div>
          <div class="layer" id="layer"></div>
          <div class="pill" id="pill">Copy mode</div>
          <div class="palette" id="palette" role="dialog" aria-label="Command palette">
            <input id="palIn" placeholder="Run an action, switch workspace or pick a theme" autocomplete="off" spellcheck="false" aria-controls="palList">
            <ul id="palList" role="listbox"></ul>
          </div>
          <div class="recon" id="recon">
            <div class="recon-card" role="status">
              <h4><span class="dot warn"></span>Connection to prod lost</h4>
              <p id="reconMsg">Reconnecting in 2 s (attempt 1). The remote session keeps running.</p>
              <div class="row"><button class="fill" id="reconNow">Reconnect now</button><button id="reconClose">Close tab</button></div>
            </div>
          </div>
          <div class="toasts" id="toasts" aria-live="polite"></div>
        </div>
      </div>

      <div class="controls">
        <span>Click the terminal, then try</span>
        <div class="try">
          <button class="chipbtn" data-act="qs"><kbd data-k="qs"></kbd>Quick select</button>
          <button class="chipbtn" data-act="cm"><kbd data-k="cm"></kbd>Copy mode</button>
          <button class="chipbtn" data-act="pal"><kbd data-k="pal"></kbd>Command palette</button>
          <button class="chipbtn" data-act="drop">Drop the SSH connection</button>
        </div>
      </div>
      <div class="swatches" id="swatches" role="group" aria-label="Terminal theme"></div>
    </div>
  </section>

  <!-- features -->
  <section id="features">
    <div class="sec-head">
      <h2>Essential tools, built in</h2>
      <p>microterm includes the capabilities that teams typically assemble from separate tools. You can record terminal sessions for documentation and review, and you can reach every action through a searchable command palette. Shell integration tracks commands, their output and their exit status. Remote control lets scripts and automation drive the terminal from the command line. Each feature works the same way on macOS and Linux.</p>
    </div>
    <div class="groups">
      <div class="group">
        <div><h3>Keyboard-Driven Text Selection</h3><p>Select and copy visible terminal text using just two keystrokes, without requiring a mouse.</p></div>
        <div class="feat">
          <div><h4>Quick Select <kbd data-k="qs"></kbd></h4><p>Automatically labels Git hashes, IP addresses, file paths, UUIDs, and URLs visible on screen. Type a label to copy the corresponding value, or enter its uppercase variant to paste it directly.</p><!-- TBD screenshot (quick-select.png): Quick select active over a git log or ls output: yellow hint labels on hashes, paths, IPs and URLs. --><figure class="shot" data-shot="quick-select"><figcaption>Screenshot TBD: Quick select active over a git log or ls output: yellow hint labels on hashes, paths, IPs and URLs.</figcaption></figure></div>
          <div><h4>Copy Mode <kbd data-k="cm"></kbd></h4><p>Navigate and select text in scrollback using familiar Vim motions, including <code>w</code>, <code>b</code>, <code>e</code>, <code>gg</code>, and <code>G</code>. Search with <code>/</code> and select rectangular blocks with <code>Ctrl-V</code>.</p><!-- TBD screenshot (copy-mode.png): Copy mode in scrollback: mode indicator visible, cursor mid-buffer, a rectangular (Ctrl-V) block selection highlighted. --><figure class="shot" data-shot="copy-mode"><figcaption>Screenshot TBD: Copy mode in scrollback: mode indicator visible, cursor mid-buffer, a rectangular (Ctrl-V) block selection highlighted.</figcaption></figure></div>
          <div><h4>Hyperlink Support</h4><p>Supports OSC 8 hyperlinks and custom regular-expression rules for automatically identifying and linking text in terminal output. Configure a rule in a single line to turn identifiers such as <code>ISSUE-12</code> into clickable links to your issue tracker or other external resources.</p><!-- TBD screenshot (hyperlinks.png): Output containing ISSUE-12 and a URL, mouse hovering the link so it is underlined, with the link target shown. --><figure class="shot" data-shot="hyperlinks"><figcaption>Screenshot TBD: Output containing ISSUE-12 and a URL, mouse hovering the link so it is underlined, with the link target shown.</figcaption></figure></div>
          <div><h4>Intuitive Mouse Support</h4><p>Full SGR mouse reporting for applications such as Vim and htop. Hold Shift to select text independently of application mouse handling. Supports word, line, and rectangular block selection.</p><!-- TBD screenshot (mouse.png): htop or Vim running with mouse reporting, plus a Shift-drag text selection made over it. --><figure class="shot" data-shot="mouse"><figcaption>Screenshot TBD: htop or Vim running with mouse reporting, plus a Shift-drag text selection made over it.</figcaption></figure></div>
        </div>
      </div>
      <div class="group">
        <div><h3>Keep sessions organised</h3><p>Organize terminal sessions with native tabs and split panes, providing a familiar workflow similar to tmux.</p></div>
        <div class="feat">
          <div><h4>Workspaces</h4><p>Create named groups of windows and tabs for different projects or environments. Switch between workspaces such as <code>payments</code> and <code>infra</code> to keep related tasks organized and separate.</p><!-- TBD screenshot (workspaces.png): Workspace switcher open listing payments and infra, with the active workspace's tabs visible behind it. --><figure class="shot" data-shot="workspaces"><figcaption>Screenshot TBD: Workspace switcher open listing payments and infra, with the active workspace's tabs visible behind it.</figcaption></figure></div>
          <div><h4>Command palette <kbd data-k="pal"></kbd></h4><p>Quickly find and execute actions, switch tabs and workspaces, and change themes through a searchable command palette. Fuzzy search helps locate commands, with keyboard shortcuts displayed alongside each action.</p><!-- TBD screenshot (command-palette.png): Command palette open with a partial fuzzy query, matched letters highlighted and shortcuts on the right. --><figure class="shot" data-shot="command-palette"><figcaption>Screenshot TBD: Command palette open with a partial fuzzy query, matched letters highlighted and shortcuts on the right.</figcaption></figure></div>
          <div><h4>Launcher</h4><p>Access launch profiles, SSH hosts, and workspaces from a unified launcher. Define startup workspaces in the configuration to automatically organize your terminal environment when you launch the application.</p><!-- TBD screenshot (launcher.png): Launcher open showing launch profiles, SSH hosts and workspaces grouped in one list. --><figure class="shot" data-shot="launcher"><figcaption>Screenshot TBD: Launcher open showing launch profiles, SSH hosts and workspaces grouped in one list.</figcaption></figure></div>
          <div><h4>Splits</h4><p>Divide any tab into multiple panes for parallel workflows, with support for both local sessions and SSH connections. Optionally enable mouse-following focus to switch between panes simply by moving the pointer.</p><!-- TBD screenshot (splits.png): One tab split into three panes (one local, one SSH), focused pane border highlighted. --><figure class="shot" data-shot="splits"><figcaption>Screenshot TBD: One tab split into three panes (one local, one SSH), focused pane border highlighted.</figcaption></figure></div>
        </div>
      </div>
      <div class="group">
        <div><h3>Flexible Configuration</h3><p>Customize your terminal with a single configuration file and apply changes instantly, without restarting.</p></div>
        <div class="feat">
          <div><h4>Live Configuration</h4><p>Save <code>microterm.toml</code> and colours, fonts and keys change in every window. A typo shows the line and column and keeps the last good config.</p><!-- TBD screenshot (live-config.png): Editor with microterm.toml beside a terminal window, ideally the config error banner showing line and column. --><figure class="shot" data-shot="live-config"><figcaption>Screenshot TBD: Editor with microterm.toml beside a terminal window, ideally the config error banner showing line and column.</figcaption></figure></div>
          <div><h4>Extensive Dark and Light Theme Collection</h4><p>Choose from an extensive theme collection. Optionally synchronize the terminal's appearance with your system's light or dark mode.</p><!-- TBD screenshot (themes.png): Grid or side-by-side of the same session in several themes (e.g. One Dark, One Light, Tokyo Night, Catppuccin). --><figure class="shot" data-shot="themes"><figcaption>Screenshot TBD: Grid or side-by-side of the same session in several themes (e.g. One Dark, One Light, Tokyo Night, Catppuccin).</figcaption></figure></div>
          <div><h4>Advanced Typography</h4><p>Enhance terminal readability with font ligatures that separate when the cursor moves over them, colour emoji, and support for CJK characters. Configure the font fallback chain to control how different characters and symbols are rendered.</p><!-- TBD screenshot (typography.png): Code with ligatures (=>, !=, ->), one ligature broken apart under the cursor, plus colour emoji and CJK text. --><figure class="shot" data-shot="typography"><figcaption>Screenshot TBD: Code with ligatures (=>, !=, ->), one ligature broken apart under the cursor, plus colour emoji and CJK text.</figcaption></figure></div>
          <div><h4>Complete Text Styling</h4><p>Renders every text style that modern command-line tools use, including bold, italic, and strikethrough. Supports <span style="text-decoration:underline double">double</span>, <span style="text-decoration:underline wavy;text-decoration-color:#d07277">curly</span>, dotted, and coloured underlines, as well as full 24-bit true colour.</p><!-- TBD screenshot (text-styling.png): Output of a style test script: bold, italic, strikethrough, double/curly/dotted/coloured underlines and a 24-bit gradient. --><figure class="shot" data-shot="text-styling"><figcaption>Screenshot TBD: Output of a style test script: bold, italic, strikethrough, double/curly/dotted/coloured underlines and a 24-bit gradient.</figcaption></figure></div>
        </div>
      </div>
    </div>
  </section>

  <!-- config + cli -->
  <section>
    <div class="sec-head">
      <h2>Configure in TOML, script from the shell</h2>
      <p>The config is a single readable file. Everything the UI can do, <code>microterm ctl</code> can do too, with JSON output for scripts.</p>
    </div>
    <div class="split2">
      <div class="panel">
        <div class="panel-h">~/.config/microterm/microterm.toml</div>
<pre class="code"><span class="k">theme</span> = &#123; dark = <span class="str">"Tokyo Night"</span>, light = <span class="str">"One Light"</span> &#125;

<span class="sec">[font]</span>
<span class="k">family</span>    = <span class="str">"JetBrains Mono"</span>
<span class="k">size</span>      = <span class="num">13.5</span>
<span class="k">ligatures</span> = <span class="k">true</span>

<span class="sec">[[hyperlink_rules]]</span>
<span class="k">regex</span>  = <span class="str">'\b(ISSUE-\d+)\b'</span>
<span class="k">format</span> = <span class="str">"https://issues.example.com/$1"</span>

<span class="sec">[[workspaces]]</span>
<span class="k">name</span> = <span class="str">"payments"</span>
<span class="k">tabs</span> = [
  &#123; title = <span class="str">"api"</span>, cwd = <span class="str">"~/src/payments-api"</span> &#125;,
  &#123; title = <span class="str">"watch"</span>, command = [<span class="str">"cargo"</span>, <span class="str">"watch"</span>] &#125;,
]</pre>
      </div>
      <div class="panel">
        <div class="panel-h">zsh</div>
<pre class="code"><span class="cm"># open a tab in the current window and run tests</span>
$ microterm ctl tab new --title tests -- cargo test
<span class="num">14</span>

<span class="cm"># read what it printed</span>
$ microterm ctl pane get-text --pane 14 | tail -3

<span class="cm"># record a session as asciicast v2</span>
$ microterm record -o demo.cast -- ./scripts/demo.sh

<span class="cm"># jump to a workspace from anywhere</span>
$ microterm ctl workspace switch infra</pre>
      </div>
    </div>
  </section>

  <!-- ssh -->
  <section id="osc">
    <div class="sec-head">
      <h2>Terminal extensions via private OSC</h2>
      <p>Microterm reserves OSC 7700–7799 for its own extensions, so a process can drive UI state directly from the PTY stream: progress bars, tab colours, status segments, and gutter marks. Because PTY output is untrusted, the range is gated behind a master switch that is off by default and has to be explicitly turned on via the config file or the command palette only.</p>
    </div>
    <ol class="steps">
      <li><span class="n">1</span><h4>Enable the feature</h4><p>Turn on private OSC in <code>microterm.toml</code> or through the command palette. Each sequence can also be enabled or disabled individually.</p></li>
      <li><span class="n">2</span><h4>Print a sequence</h4><p>Any program can send a sequence with a single <code>printf</code> command. No plugin or extra software is required, and the sequences also work over SSH.</p></li>
      <li><span class="n">3</span><h4>See the result</h4><p>Status segments, progress bars, tab colours, pane badges, gutter marks, and pane-specific palette entries appear in the interface immediately.</p></li>
    </ol>
    <div class="ssh-cta"><a class="chipbtn" href={`${base}/docs/private-osc/`}>Read the private OSC reference</a><span>Sequences use the reserved range 7700–7799, so they do not conflict with other terminals.</span></div>
  </section>

  <!-- compare -->
  <section id="compare">
    <div class="sec-head">
      <h2>How it compares</h2>
      <p>microterm is new. Here is where it stands next to terminals you might already use, including the rows where it falls short.</p>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col"></th><th scope="col">microterm</th><th scope="col">WezTerm</th><th scope="col">Kitty</th><th scope="col">Alacritty</th><th scope="col">Ghostty</th></tr></thead>
        <tbody>
          <tr><td>macOS and Linux</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="yes">Yes</td></tr>
          <tr><td>Windows</td><td class="no">No</td><td class="yes">Yes</td><td class="no">No</td><td class="yes">Yes</td><td class="no">No</td></tr>
          <tr><td>Built-in tabs</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="no">No</td><td class="yes">Yes</td></tr>
          <tr><td>Splits</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="no">No</td><td class="yes">Yes</td></tr>
          <tr><td>SSH sessions survive disconnects</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="no">No</td></tr>
          <tr><td>Inline images</td><td class="soon">v1.2</td><td class="yes">Yes</td><td class="yes">Yes</td><td class="no">No</td><td class="yes">Yes</td></tr>
          <tr><td>Config format</td><td>TOML (Lua in v1.3)</td><td>Lua</td><td>kitty.conf</td><td>TOML</td><td>Own format</td></tr>
          <tr><td>Track record</td><td class="no">New</td><td>Years</td><td>Years</td><td>Years</td><td>Since 2024</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">As of October 2026. Check each project's documentation before deciding, and open an issue if a row is wrong.</p>
  </section>

  <!-- roadmap -->
  <section id="roadmap">
    <div class="sec-head"><h2>What's next</h2><p>Each release is small and ships when it works end to end.</p></div>
    <ol class="roadmap">
      <li class="now"><span class="v">v1.0</span><h4>Today</h4><p>Tabs, splits, workspaces, SSH, serial ports, quick select, copy mode, CLI.</p></li>
      <li><span class="v">v1.2</span><h4>Images</h4><p>Kitty and iTerm2 graphics.</p></li>
      <li><span class="v">v1.3</span><h4>Lua config</h4><p>Logic, variables and callbacks, same schema as TOML.</p></li>
      <li><span class="v">v1.4</span><h4>Plugins</h4><p>One-line GitHub plugins, pinned to a commit.</p></li>
    </ol>
  </section>

  <!-- install -->
  <section id="install">
    <div class="sec-head"><h2>Install</h2><p>Every method installs the same signed build and the <code>microterm</code> command.</p></div>
    <div class="panel">
      <div class="install-tabs" role="tablist" id="instTabs">
        <button role="tab" aria-selected="true" data-i="0">Homebrew (macOS)</button>
        <button role="tab" aria-selected="false" data-i="1">Homebrew (Linux)</button>
        <button role="tab" aria-selected="false" data-i="2">Install script</button>
        <button role="tab" aria-selected="false" data-i="3">Manual download</button>
      </div>
      <div class="install-body">
        <pre class="code" id="instCode"></pre>
        <button class="copy" id="instCopy">Copy</button>
      </div>
    </div>
  </section>
</div>
</main>

<footer>
  <div class="wrap">
    <span>microterm is MIT licensed. Built with Rust and GPUI. <a href="https://github.com/0funct0ry/microterm/blob/main/LICENSE">LICENSE</a> · <a href={`${base}/THIRD-PARTY-LICENSES.html`}>Third-party notices</a></span>
    <nav aria-label="Footer"><a href={`${base}/docs/installation/`}>Docs</a><a href="https://github.com/0funct0ry/microterm">GitHub</a><a href="https://github.com/0funct0ry/microterm/releases">Releases</a><a href={`${base}/docs/roadmap/`}>Roadmap</a><a href={`${base}/docs/changelog/`}>Changelog</a><a href="https://github.com/0funct0ry/microterm/blob/main/LICENSE">LICENSE</a><a href={`${base}/THIRD-PARTY-LICENSES.html`}>Third-party notices</a></nav>
  </div>
</footer>
  <script>
    import '../scripts/demo.js';
  </script>
  </body>
</html>
