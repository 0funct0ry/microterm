---
// Marketing page (SPEC §16), implemented from MARKETING-MOCKUP.html.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/marketing.css';
import logo from '../assets/logo.svg';
import { VERSION } from '../version';
import { Image } from 'astro:assets';
import shotQuickSelect from '../assets/screens/quick-select.png';
import shotCopyMode from '../assets/screens/copy-mode.png';
import shotHyperlinks from '../assets/screens/hyperlinks.png';
import shotMouse from '../assets/screens/mouse.png';
import shotWorkspaces from '../assets/screens/workspaces.png';
import shotCommandPalette from '../assets/screens/command-palette.png';
import shotLauncher from '../assets/screens/launcher.png';
import shotSplits from '../assets/screens/splits.png';
import shotLiveConfig from '../assets/screens/live-config.png';
import shotThemes from '../assets/screens/themes.png';
import shotTypography from '../assets/screens/typography.png';
import shotTextStyling from '../assets/screens/text-styling.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://0funct0ry.github.io/microterm';
const version = VERSION;
const title = 'microterm: a high-performance, cross-platform terminal with GPU acceleration';
const description =
  'GPU-rendered terminal with workspaces, quick select, vi-style copy mode and SSH sessions that survive a dropped connection. Configured in one TOML file.';
---
<!doctype html>
<html lang="en" data-version={version}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem('starlight-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class="mk">
<header class="nav">
  <div class="wrap">
    <a class="brand" href={`${base}/`}><img class="brand-mark" src={logo.src} width="24" height="24" alt="" />microterm</a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#features" class="hide-sm">Features</a>
      <a href="#osc" class="hide-sm">Integrations</a>
      <a href="#principles" class="hide-sm">Principles</a>
      <a href={`${base}/docs/installation/`}>Docs</a>
      <a href="https://github.com/0funct0ry/microterm">GitHub</a>
    </nav>
    <button class="icon-btn" id="pageTheme" aria-label="Toggle light and dark page theme" title="Toggle page theme">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<main>
<div class="wrap">
  <section class="hero" style="padding-top:72px">
    <h1>A high-performance, cross-platform terminal with GPU acceleration.</h1>
    <p class="lede">Featuring GPU-accelerated rendering, zero-config setup, automatic configuration reload on save, built-in workspaces, shell integration and more.</p>
    <div class="cta">
      <a class="btn primary" href="#install">Get started</a>
      <a class="btn" href={`${base}/docs/installation/`}>Read the docs</a>
    </div>
    <p class="meta-line">v{version} for macOS 12+ and Linux (Wayland or X11). MIT licensed.</p>

    <!-- shortcuts -->
    <div class="demo">
      <p class="demo-lead">Every action has a default shortcut, and every shortcut can be rebound in the configuration file.</p>
      <div class="keycaps">
        <div style="--i:0"><div class="keys" data-keys="pal" aria-hidden="true"></div><h3>Command palette</h3><p>Run any action by name.</p></div>
        <div style="--i:1"><div class="keys" data-keys="qs" aria-hidden="true"></div><h3>Quick select</h3><p>Copy hashes, IP addresses, and URLs by label.</p></div>
        <div style="--i:2"><div class="keys" data-keys="cm" aria-hidden="true"></div><h3>Copy mode</h3><p>Navigate scrollback with Vim motions.</p></div>
        <div style="--i:3"><div class="keys" data-keys="la" aria-hidden="true"></div><h3>Launcher</h3><p>Open profiles, hosts, and workspaces.</p></div>
        <div style="--i:4"><div class="keys" data-keys="ws" aria-hidden="true"></div><h3>Workspaces</h3><p>Switch between projects instantly.</p></div>
        <div style="--i:5"><div class="keys" data-keys="sr" aria-hidden="true"></div><h3>Split right</h3><p>Open a second pane side by side.</p></div>
        <div style="--i:6"><div class="keys" data-keys="sd" aria-hidden="true"></div><h3>Split down</h3><p>Stack a second pane below.</p></div>
        <div style="--i:7"><div class="keys" data-keys="nt" aria-hidden="true"></div><h3>New tab</h3><p>Start another shell in one keystroke.</p></div>
      </div>
    </div>
  </section>

  <!-- features -->
  <section id="features">
    <div class="sec-head">
      <h2>Essential tools, built in</h2>
      <p>microterm includes the capabilities that teams typically assemble from separate tools. You can record terminal sessions for documentation and review, and you can reach every action through a searchable command palette. Shell integration tracks commands, their output and their exit status. Remote control lets scripts and automation drive the terminal from the command line. Each feature works the same way on macOS and Linux.</p>
    </div>
    <div class="groups">
      <div class="group">
        <div><h3>Keyboard-Driven Text Selection</h3><p>Select and copy visible terminal text using just two keystrokes, without requiring a mouse.</p></div>
        <div class="feat">
          <div><h4>Quick Select <kbd data-k="qs"></kbd></h4><p>Automatically labels Git hashes, IP addresses, file paths, UUIDs, and URLs visible on screen. Type a label to copy the corresponding value, or enter its uppercase variant to paste it directly.</p><figure class="shot" data-shot="quick-select"><button type="button" class="shot-btn" data-full={shotQuickSelect.src} aria-label="Enlarge screenshot: Quick Select hint labels over git log output"><Image src={shotQuickSelect} alt="Quick Select hint labels over git log output" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Copy Mode <kbd data-k="cm"></kbd></h4><p>Navigate and select text in scrollback using familiar Vim motions, including <code>w</code>, <code>b</code>, <code>e</code>, <code>gg</code>, and <code>G</code>. Search with <code>/</code> and select rectangular blocks with <code>Ctrl-V</code>.</p><figure class="shot" data-shot="copy-mode"><button type="button" class="shot-btn" data-full={shotCopyMode.src} aria-label="Enlarge screenshot: Copy Mode with a rectangular block selection in the scrollback"><Image src={shotCopyMode} alt="Copy Mode with a rectangular block selection in the scrollback" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Hyperlink Support</h4><p>Supports OSC 8 hyperlinks and custom regular-expression rules for automatically identifying and linking text in terminal output. Configure a rule in a single line to turn identifiers such as <code>ISSUE-12</code> into clickable links to your issue tracker or other external resources.</p><figure class="shot" data-shot="hyperlinks"><button type="button" class="shot-btn" data-full={shotHyperlinks.src} aria-label="Enlarge screenshot: Terminal output with a hovered, underlined hyperlink"><Image src={shotHyperlinks} alt="Terminal output with a hovered, underlined hyperlink" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Intuitive Mouse Support</h4><p>Full SGR mouse reporting for applications such as Vim and htop. Hold Shift to select text independently of application mouse handling. Supports word, line, and rectangular block selection.</p><figure class="shot" data-shot="mouse"><button type="button" class="shot-btn" data-full={shotMouse.src} aria-label="Enlarge screenshot: Shift-drag text selection over an application using mouse reporting"><Image src={shotMouse} alt="Shift-drag text selection over an application using mouse reporting" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
        </div>
      </div>
      <div class="group">
        <div><h3>Keep sessions organised</h3><p>Organize terminal sessions with native tabs and split panes, providing a familiar workflow similar to tmux.</p></div>
        <div class="feat">
          <div><h4>Workspaces</h4><p>Create named groups of windows and tabs for different projects or environments. Switch between workspaces such as <code>payments</code> and <code>infra</code> to keep related tasks organized and separate.</p><figure class="shot" data-shot="workspaces"><button type="button" class="shot-btn" data-full={shotWorkspaces.src} aria-label="Enlarge screenshot: Workspace switcher listing the payments and infra workspaces"><Image src={shotWorkspaces} alt="Workspace switcher listing the payments and infra workspaces" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Command palette <kbd data-k="pal"></kbd></h4><p>Quickly find and execute actions, switch tabs and workspaces, and change themes through a searchable command palette. Fuzzy search helps locate commands, with keyboard shortcuts displayed alongside each action.</p><figure class="shot" data-shot="command-palette"><button type="button" class="shot-btn" data-full={shotCommandPalette.src} aria-label="Enlarge screenshot: Command palette with a fuzzy query and keyboard shortcuts"><Image src={shotCommandPalette} alt="Command palette with a fuzzy query and keyboard shortcuts" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Launcher</h4><p>Access launch profiles, SSH hosts, and workspaces from a unified launcher. Define startup workspaces in the configuration to automatically organize your terminal environment when you launch the application.</p><figure class="shot" data-shot="launcher"><button type="button" class="shot-btn" data-full={shotLauncher.src} aria-label="Enlarge screenshot: Launcher listing launch profiles, SSH hosts, and workspaces"><Image src={shotLauncher} alt="Launcher listing launch profiles, SSH hosts, and workspaces" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Splits</h4><p>Divide any tab into multiple panes for parallel workflows, with support for both local sessions and SSH connections. Optionally enable mouse-following focus to switch between panes simply by moving the pointer.</p><figure class="shot" data-shot="splits"><button type="button" class="shot-btn" data-full={shotSplits.src} aria-label="Enlarge screenshot: A tab split into several local and SSH panes"><Image src={shotSplits} alt="A tab split into several local and SSH panes" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
        </div>
      </div>
      <div class="group">
        <div><h3>Flexible Configuration</h3><p>Customize your terminal with a single configuration file and apply changes instantly, without restarting.</p></div>
        <div class="feat">
          <div><h4>Live Configuration</h4><p>Save <code>microterm.toml</code> and colours, fonts and keys change in every window. A typo shows the line and column and keeps the last good config.</p><figure class="shot" data-shot="live-config"><button type="button" class="shot-btn" data-full={shotLiveConfig.src} aria-label="Enlarge screenshot: microterm.toml being edited with changes applied live"><Image src={shotLiveConfig} alt="microterm.toml being edited with changes applied live" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Extensive Dark and Light Theme Collection</h4><p>Choose from an extensive theme collection. Optionally synchronize the terminal's appearance with your system's light or dark mode.</p><figure class="shot" data-shot="themes"><button type="button" class="shot-btn" data-full={shotThemes.src} aria-label="Enlarge screenshot: The same session shown in several bundled themes"><Image src={shotThemes} alt="The same session shown in several bundled themes" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Advanced Typography</h4><p>Enhance terminal readability with font ligatures that separate when the cursor moves over them, colour emoji, and support for CJK characters. Configure the font fallback chain to control how different characters and symbols are rendered.</p><figure class="shot" data-shot="typography"><button type="button" class="shot-btn" data-full={shotTypography.src} aria-label="Enlarge screenshot: Code with ligatures, colour emoji, and CJK text"><Image src={shotTypography} alt="Code with ligatures, colour emoji, and CJK text" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
          <div><h4>Complete Text Styling</h4><p>Renders every text style that modern command-line tools use, including bold, italic, and strikethrough. Supports <span style="text-decoration:underline double">double</span>, <span style="text-decoration:underline wavy;text-decoration-color:#d07277">curly</span>, dotted, and coloured underlines, as well as full 24-bit true colour.</p><figure class="shot" data-shot="text-styling"><button type="button" class="shot-btn" data-full={shotTextStyling.src} aria-label="Enlarge screenshot: Bold, italic, strikethrough, underline styles, and a true-colour gradient"><Image src={shotTextStyling} alt="Bold, italic, strikethrough, underline styles, and a true-colour gradient" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="lazy" /></button></figure></div>
        </div>
      </div>
    </div>
  </section>

  <!-- config + cli -->
  <section id="configure">
    <div class="sec-head">
      <h2>Configure in TOML, script from the shell</h2>
      <p>The config is a single readable file. Everything the UI can do, <code>microterm ctl</code> can do too, with JSON output for scripts.</p>
    </div>
    <div class="cs-story">
      <div class="cs-scene"><div class="cs-st"><span class="cs-num">1</span><div><h3>Two ways in</h3><p>Edit a single TOML file, or drive the running app with <code>microterm ctl</code>. Both change the same live state.</p></div></div><svg viewBox="0 0 760 300" role="img" aria-label="Both the TOML file and microterm ctl change the running app, which updates themes, fonts, tabs and splits live"><defs><marker id="cs-ar" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0L8 4L0 8z" fill="var(--accent)"/></marker></defs><g font-family="sans-serif"><rect x="20" y="40" width="190" height="80" rx="12" fill="var(--surface)" stroke="var(--border)"/><text x="115" y="72" text-anchor="middle" font-size="15" font-weight="700" fill="var(--text)">microterm.toml</text><text x="115" y="96" text-anchor="middle" font-size="12.5" fill="var(--muted)">edit, save, done</text><rect x="20" y="180" width="190" height="80" rx="12" fill="#16171a" stroke="#2b2e35"/><text x="115" y="212" text-anchor="middle" font-size="15" font-weight="700" fill="#7ee787" font-family="monospace">$ microterm ctl</text><text x="115" y="236" text-anchor="middle" font-size="12.5" fill="#8b949e">script it, get JSON</text><path class="cs-flow" d="M210 80 C290 80 290 150 340 150" fill="none" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#cs-ar)"/><path class="cs-flow" d="M210 220 C290 220 290 150 340 150" fill="none" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#cs-ar)"/><rect x="345" y="90" width="150" height="120" rx="14" fill="#282c33" stroke="#464b57"/><circle cx="364" cy="108" r="5" fill="#ff5f57"/><circle cx="380" cy="108" r="5" fill="#febc2e"/><circle cx="396" cy="108" r="5" fill="#28c840"/><text x="420" y="168" text-anchor="middle" font-size="17" font-weight="700" fill="#dce0e5">microterm</text><text x="420" y="190" text-anchor="middle" font-size="12" fill="#a9afbc">live, no restart</text><path class="cs-flow" d="M495 150 C540 150 540 55 580 55" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#cs-ar)" style="animation-delay:0.0s"/><rect x="584" y="38" width="150" height="34" rx="17" fill="var(--accent-soft)" stroke="var(--accent)"/><text x="659" y="60" text-anchor="middle" font-size="14" font-weight="600" fill="var(--accent)">Themes</text><path class="cs-flow" d="M495 150 C540 150 540 118 580 118" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#cs-ar)" style="animation-delay:0.2s"/><rect x="584" y="101" width="150" height="34" rx="17" fill="var(--accent-soft)" stroke="var(--accent)"/><text x="659" y="123" text-anchor="middle" font-size="14" font-weight="600" fill="var(--accent)">Fonts</text><path class="cs-flow" d="M495 150 C540 150 540 181 580 181" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#cs-ar)" style="animation-delay:0.4s"/><rect x="584" y="164" width="150" height="34" rx="17" fill="var(--accent-soft)" stroke="var(--accent)"/><text x="659" y="186" text-anchor="middle" font-size="14" font-weight="600" fill="var(--accent)">Tabs</text><path class="cs-flow" d="M495 150 C540 150 540 244 580 244" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#cs-ar)" style="animation-delay:0.6000000000000001s"/><rect x="584" y="227" width="150" height="34" rx="17" fill="var(--accent-soft)" stroke="var(--accent)"/><text x="659" y="249" text-anchor="middle" font-size="14" font-weight="600" fill="var(--accent)">Splits</text></g></svg></div>
      <div class="cs-scene" id="cs-map"><div class="cs-st"><span class="cs-num">2</span><div><h3>See what each setting does</h3><p>Every setting in the file maps to something you can see: colours, text, links, and tabs.</p></div></div><div class="cs-two"><div class="cs-code"><div class="cs-ph">~/.config/microterm/microterm.toml</div><pre><span class="cs-ln" data-p="theme"><span class="k">theme</span> = &#123; dark = <span class="str">"Tokyo Night"</span>, light = <span class="str">"One Light"</span> &#125;</span><span class="cs-ln" data-p="font"><span class="sec">[font]</span>
<span class="k">family</span> = <span class="str">"JetBrains Mono"</span>
<span class="k">size</span>   = <span class="num">13.5</span></span><span class="cs-ln" data-p="link"><span class="sec">[[hyperlink_rules]]</span>
<span class="k">regex</span>  = <span class="str">'\b(ISSUE-\d+)\b'</span>
<span class="k">format</span> = <span class="str">"https://issues.example.com/$1"</span></span><span class="cs-ln" data-p="tabs"><span class="sec">[[workspaces.tabs]]</span>
<span class="k">title</span> = <span class="str">"api"</span>
<span class="k">cwd</span>   = <span class="str">"~/src/payments-api"</span></span></pre></div><div class="cs-win"><div class="cs-mw"><div class="cs-tb"><i></i><i></i><i></i><span class="cs-chip">payments</span></div><div class="cs-tabs"><span class="on">api</span><span>tests</span></div><pre class="cs-out"><span class="a">payments-api</span> main ❯ cargo test
running 42 tests ... ok
see <span class="cs-lk on">ISSUE-12</span> for details</pre><div class="cs-toast">Saved · applied live</div></div><span class="cs-lbl"></span></div></div></div>
      <div class="cs-scene" id="cs-live"><div class="cs-st"><span class="cs-num">3</span><div><h3>Edit and watch it apply</h3><p>Save the file and every window updates within a moment, without a restart.</p></div></div><div class="cs-two"><div class="cs-code"><div class="cs-ph">~/.config/microterm/microterm.toml</div><pre class="cs-live"><span class="cs-ln"><span class="k">theme</span> = <span class="str">"Tokyo Night"</span></span><span class="cs-ln"> </span><span class="cs-ln"><span class="sec">[font]</span></span><span class="cs-ln"><span class="k">family</span> = <span class="str">"JetBrains Mono"</span></span><span class="cs-ln"><span class="k">size</span>   = <span class="num">13.5</span></span><span class="cs-ln"><span class="k">ligatures</span> = <span class="k">true</span></span></pre></div><div class="cs-mw"><div class="cs-tb"><i></i><i></i><i></i><span class="cs-chip">payments</span></div><div class="cs-tabs"><span class="on">api</span><span>tests</span></div><pre class="cs-out"><span class="a">payments-api</span> main ❯ cargo test
running 42 tests ... ok
see <span class="cs-lk on">ISSUE-12</span> for details</pre><div class="cs-toast">Saved · applied live</div></div></div></div>
      <div class="cs-scene" id="cs-shell"><div class="cs-st"><span class="cs-num">4</span><div><h3>Script it from the shell</h3><p>Everything the UI can do, <code>microterm ctl</code> can do, with JSON output for scripts.</p></div></div><div class="cs-three"><div class="cs-zsh"><div class="cs-ph">zsh</div><pre class="cs-term"><span class="p">$</span> microterm ctl tab new --title tests -- cargo test
<span class="d">14</span>
</pre></div><div class="cs-mid"><div class="cs-pipe"><span class="cs-dot"></span></div></div><div class="cs-mw"><div class="cs-tb"><i></i><i></i><i></i><span class="cs-chip">payments</span></div><div class="cs-tabs"><span>api</span><span class="on">tests</span></div><pre class="cs-out"><span class="a">payments-api</span> main ❯ cargo test
running 42 tests ... ok
see <span class="cs-lk on">ISSUE-12</span> for details</pre><div class="cs-toast">Saved · applied live</div></div></div></div>
    </div>
  </section>

  <!-- ssh -->
  <section id="osc">
    <div class="sec-head">
      <h2>Terminal extensions via private OSC</h2>
      <p>Microterm reserves OSC 7700–7799 for its own extensions, so a process can drive UI state directly from the PTY stream: progress bars, tab colours, status segments, and gutter marks. Because PTY output is untrusted, the range is gated behind a master switch that is off by default and has to be explicitly turned on via the config file or the command palette only.</p>
    </div>
    <ol class="steps">
      <li><span class="n">1</span><h4>Enable the feature</h4><p>Turn on private OSC in <code>microterm.toml</code> or through the command palette. Each sequence can also be enabled or disabled individually.</p></li>
      <li><span class="n">2</span><h4>Print a sequence</h4><p>Any program can send a sequence with a single <code>printf</code> command. No plugin or extra software is required, and the sequences also work over SSH.</p></li>
      <li><span class="n">3</span><h4>See the result</h4><p>Status segments, progress bars, tab colours, pane badges, gutter marks, and pane-specific palette entries appear in the interface immediately.</p></li>
    </ol>
    <div class="ssh-cta"><a class="chipbtn" href={`${base}/docs/private-osc/`}>Read the private OSC reference</a><span>Sequences use the reserved range 7700–7799, so they do not conflict with other terminals.</span></div>
  </section>

  <!-- principles -->
  <section id="principles">
    <div class="sec-head">
      <h2>Design principles</h2>
      <p>A small set of commitments that shape every decision in microterm.</p>
    </div>
    <div class="bento">
      <div class="bento-lead">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/></svg>
        <div class="bento-bars" aria-hidden="true"><span style="height:40%"></span><span style="height:55%"></span><span style="height:48%"></span><span style="height:70%"></span><span style="height:62%"></span><span style="height:85%"></span><span style="height:78%"></span><span style="height:92%"></span><span style="height:88%"></span><span style="height:100%"></span></div>
        <h3>GPU-Rendered</h3>
        <p>Every frame is drawn on the GPU through GPUI, so scrolling and large outputs stay smooth.</p>
      </div>
      <div>
